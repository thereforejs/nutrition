{
  "name": "@thereforejs/nutrition",
  "version": "0.0.1",
  "description": "Nutrition declaration from recipes under the EU food information regulation (Regulation (EU) No 1169/2011, known as FIC, LMIV or INCO)",
  "keywords": [
    "1169-2011",
    "energy",
    "fic",
    "food-information",
    "food-labelling",
    "inco",
    "lmiv",
    "nutrition",
    "nutrition-declaration",
    "recipe"
  ],
  "homepage": "https://github.com/thereforejs/nutrition#readme",
  "bugs": {
    "url": "https://github.com/thereforejs/nutrition/issues"
  },
  "license": "MIT",
  "author": "Florian Heuberger",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/thereforejs/nutrition.git"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./dist/index.mjs",
    "./locales": "./dist/locales/index.mjs",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "vp pack",
    "dev": "vp pack --watch",
    "test": "vp test",
    "check": "vp check",
    "prepack": "vp check && vp test run && vp pack",
    "prepare": "vp config",
    "example": "vpx examples/recipes.ts"
  },
  "dependencies": {
    "@thereforejs/decy": "^0.1.1"
  },
  "devDependencies": {
    "@thereforejs/foods": ">=0.0.1 <0.1.0",
    "@types/node": "^26.6.5",
    "fast-check": "^4.10.2",
    "typescript": "^7.0.2",
    "vite-plus": "catalog:"
  },
  "peerDependencies": {
    "@thereforejs/food-finder": ">=0.0.1 <0.1.0",
    "@thereforejs/foods": ">=0.0.1 <0.1.0"
  },
  "peerDependenciesMeta": {
    "@thereforejs/food-finder": {
      "optional": true
    },
    "@thereforejs/foods": {
      "optional": true
    }
  },
  "packageManager": "pnpm@12.15.0"
}
